# Copiez ce fichier en .env.local et remplissez les valeurs avant de lancer l'application.

# Mot de passe pour accéder à l'application (vous seul l'utilisez).
APP_PASSWORD=

# Clé secrète utilisée pour signer la session de connexion.
# Générez-en une avec : openssl rand -hex 32
AUTH_SECRET=

# Optionnel : emplacement du fichier de base de données SQLite.
# Par défaut : ./data/pricebook.db
# DATABASE_PATH=./data/pricebook.db
